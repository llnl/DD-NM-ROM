{
  "name": "dd_fom_unsteady",
  "target": "benchmarks.workloads_dd:dd_fom_unsteady",
  "warmups": 0,
  "repetitions": 1,
  "threads": 8,
  "config": {
    "n_sub_x": 4,
    "n_sub_y": 4,
    "nx_intr": 48,
