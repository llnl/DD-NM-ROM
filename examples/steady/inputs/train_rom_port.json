{
  "pathfile": "./../../../PATHS.txt",
  "env": {
    "backend": "torch",
    "device": "cuda",
    "device_idx": 0,
    "nb_threads": 8,
    "epsilon": 1e-10,
    "floatx": "float64",
    "seed": 0
  },

  "mesh": {
    "name": "MeshDD",
    "kwargs": {
      "nx_intr": 239,
      "ny_intr": 11,
      "lx_sub": 1.0,
      "ly_sub": 0.025,
      "x0": -1.0,
      "y0": 0.0,
      "n_sub_x": 2,
      "n_sub_y": 2
    }
  },

  "field": {
    "name": "Burgers2DExact",
    "kwargs": {
      "nu": 1e-1,
      "a_lim": [1.0, 1e4],
      "k_lim": [5.0, 25.0]
    }
  },

  "fom": {
    "name": "Burgers2D",
    "kwargs": {
      "nu": 1e-1
    }
  },

  "trainable": {
    "elements": ["port"],
    "ports": null,
    "subdomains": null,
    "merged": true
  },

  "data_load": {
    "n_workers": 32,
    "ranges": [0,6400],
    "key": "snapshots",
    "path": "/g/g92/zanardi1/Workspace/Codes/DD-NM-ROM/run/steady/dset.01/datagen/"
  },

  "data": {
    "validation_split": 0.2,
    "batch_size": 64
  },

  "autoencoder": {
    "dim": {
      "port": {
        "latent_dim": 4,
        "row_shift": 3,
        "row_nonzero": 3
      },
      "interior": {
        "latent_dim": 12,
        "row_shift": 5,
        "row_nonzero": 5
      },
      "interface": {
        "latent_dim": 8,
        "row_shift": 5,
        "row_nonzero": 5
      }
    },
    "common": {
      "min_input_dim": 5,
      "encoder_dense": false,
      "encoder_hidden": -1,
      "activation": "sigmoid",
      "add_noise": true,
      "loading": false,
      "saved_model": ""
    }
  },

  "model": {
    "path": "/g/g92/zanardi1/Workspace/Codes/DD-NM-ROM/run/steady/dset.01/nets/run.01",
    "compile": {
      "optimizer": "adam",
      "lr": 1e-3,
      "lr_decay": {
        "name": "reduce_on_plateau",
        "factor": 0.8,
        "patience": 100,
        "min_lr": 1e-6
      },
      "weight_decay": 0.0,
      "loss": "mse",
      "monitor": "val_loss",
      "reduction": "mean",
      "callbacks": {
        "early_stopping": {
          "monitor": "val_loss",
          "min_delta": 1e-6,
          "patience": 1000
        },
        "checkpoint": {
          "monitor": "val_loss",
          "save_best_only": true
        },
        "lr_tracker": {
          "verbose": true
        }
      }
    },
    "train": {
      "epochs": 3000,
      "display_freq": 100,
      "saving": true
    }
  }

}
