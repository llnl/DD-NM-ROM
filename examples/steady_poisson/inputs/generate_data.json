{
  "pathfile": "./../../../PATHS.txt",
  "env": {
    "backend": "numpy",
    "device": "cpu",
    "device_idx": 0,
    "nb_threads": 4,
    "epsilon": 1e-10,
    "floatx": "float64",
    "seed": 0
  },
  "mesh": {
    "name": "MeshDD",
    "kwargs": {
      "nx_intr": 48,
      "ny_intr": 48,
      "lx_sub": 0.5,
      "ly_sub": 0.5,
      "x0": 0.0,
      "y0": 0.0,
      "n_sub_x": 2,
      "n_sub_y": 2,
      "with_bounds": true
    }
