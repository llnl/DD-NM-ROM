{
  "pathfile": "./../../../PATHS.txt",
  "env": {
    "backend": "torch",
    "device": "cuda",
    "device_idx": 0,
    "nb_threads": 8,
    "epsilon": 1e-10,
    "floatx": "float64",
    "seed": 0
  },

  "mesh": {
    "name": "MeshDD",
    "kwargs": {
      "nx_intr": 48,
      "ny_intr": 48,
      "lx_sub": 0.5,
      "ly_sub": 0.5,
      "x0": 0.0,
      "y0": 0.0,
      "n_sub_x": 2,
      "n_sub_y": 2,
      "with_bounds": true
    }
  },

  "field": {
    "name": "PoissonForce",
    "kwargs": {
      "mu_lim": [80, 82.5],
      "forced_config": [0,0,0,0],
      "bc_type": "periodic"
    }
  },

  "fom": {
    "name": "Poisson2D",
    "kwargs": {
      "nu": 1
    }
  },

  "trainable": {
    "elements": ["port"],
    "ports": null,
    "subdomains": null,
    "merged": true
  },

  "data_load": {
    "n_workers": 32,
    "ranges": [0,2000],
    "key": "snapshots",
    "path": "/home/pinghsuan/Research/DD-NM-ROM/run/Poisson_k2/dset.2by2/datagen/train"
  },

  "data_load_2": {
    "n_workers": 32,
    "ranges": [0,1000],
    "key": "snapshots",
    "path": "/home/pinghsuan/Research/DD-NM-ROM_old/run/unsteady/dset.2by2/datagen/train"
  },

  "data": {
    "validation_split": 0.2,
    "batch_size": 1024
  },

  "autoencoder": {
    "dim": {
      "port": {
        "latent_dim": 10,
        "row_shift": 3,
        "row_nonzero": 3
      }
    },
    "common": {
      "min_input_dim": 5,
      "encoder_dense": false,
      "encoder_hidden": -1,
      "activation": "swish",
      "add_noise": true,
      "loading": false,
      "saved_model": ""
    }
  },

  "model": {
    "path": "/home/pinghsuan/Research/DD-NM-ROM/run/Poisson_k2/dset.2by2/nets/",
    "compile": {
      "optimizer": "adam",
      "lr": 1e-3,
      "lr_decay": {
        "name": "reduce_on_plateau",
        "factor": 0.8,
        "patience": 50,
        "min_lr": 1e-6
      },
      "weight_decay": 0.0,
      "loss": "mse",
      "monitor": "val_loss",
      "reduction": "mean",
      "callbacks": {
        "early_stopping": {
          "monitor": "val_loss",
          "min_delta": 1e-8,
          "patience": 500
        },
        "checkpoint": {
          "monitor": "val_loss",
          "save_best_only": true
        },
        "lr_tracker": {
	  "plotting": false,
          "verbose": true
        },
        "history": {
	  "plotting": 0
        }
      }
    },
    "train": {
      "epochs": 1000,
      "display_freq": 50,
      "saving": true
    }
  }

}
