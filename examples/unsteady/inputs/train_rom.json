{
  "pathfile": "./../../../PATHS.txt",
  "env": {
    "backend": "torch",
    "device": "cuda",
    "device_idx": 0,
    "nb_threads": 8,
    "epsilon": 1e-10,
    "floatx": "float64",
    "seed": 0
  },
  "mesh": {
    "name": "MeshDD",
    "kwargs": {
      "nx_intr": 48,
      "ny_intr": 48,
      "lx_sub": 0.5,
      "ly_sub": 0.5,
      "x0": 0.0,
      "y0": 0.0,
      "n_sub_x": 2,
      "n_sub_y": 2,
      "with_bounds": true
    }
  },
  "field": {
    "name": "SinMultiPeak",
    "kwargs": {
      "mu_lim": [0.5, 1.5],
      "forced_config": [1,0,0,0],
      "bc_type": "periodic"
    }
  },
  "fom": {
    "name": "Burgers2D",
    "kwargs": {
      "nu": 1e-3
    }
  },
  "trainable": {
    "elements": ["interior"],
    "ports": null,
    "subdomains": null,
    "merged": true
  },
  "data_load": {
    "n_workers": 32,
    "ranges": [0,2000],
    "key": "snapshots",
    "path": "/usr/workspace/nlrom/DD-NM-ROM/dataset/unsteady_5e-3_general/dset.2by2/datagen/train/"
  },
  "data": {
    "validation_split": 0.2,
    "batch_size": 1024
  },
  "autoencoder": {
    "dim": {
      "interior": {
        "latent_dim": 21,
        "row_shift": 5,
        "row_nonzero": 10
      }
    },
    "common": {
      "min_input_dim": 5,
      "encoder_dense": false,
      "encoder_hidden": -1,
      "activation": "swish",
      "add_noise": true,
      "loading": false,
      "saved_model": ""
    }
  },
  "model": {
    "path": "/p/lustre5/cheung26/DD_NM_ROM_cole/examples/unsteady/unsteady_5e-3_general/dset.2by2/nets/run.01/",
    "compile": {
      "optimizer": "adam",
      "lr": 1e-3,
      "lr_decay": {
        "name": "reduce_on_plateau",
        "factor": 0.8,
        "patience": 50,
        "min_lr": 1e-6
      },
      "weight_decay": 0.0,
      "loss": "mse",
      "monitor": "val_loss",
      "reduction": "mean",
      "callbacks": {
        "early_stopping": {
          "monitor": "val_loss",
          "min_delta": 1e-8,
          "patience": 500
        },
        "checkpoint": {
          "monitor": "val_loss",
          "save_best_only": true
        },
        "lr_tracker": {
          "verbose": true
        }
      }
    },
    "train": {
      "epochs": 1000,
      "display_freq": 50,
      "saving": true
    }
  }
}
